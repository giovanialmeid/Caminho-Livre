# Copie este arquivo pra .env.local e coloque sua chave de verdade.
# .env.local nunca deve ser compartilhado (ver .gitignore).
#
# A chave e gratuita: https://aistudio.google.com/app/apikey
#
# SEM a chave o sistema continua funcionando: a classificacao do problema
# passa a ser feita pelo classificador local por palavras-chave (plano B).

GEMINI_API_KEY=